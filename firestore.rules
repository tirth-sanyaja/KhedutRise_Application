rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Farmer profile & private agricultural data
    match /farmers/{farmerId} {
      // Only authenticated user can read or write their own farm data
      allow read, write: if request.auth != null && request.auth.uid == farmerId;

      // Crop leaf scans and AI diagnosis history
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == farmerId;
      }

      // AI farming assistant conversation history
      match /chat_messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == farmerId;
      }

      // AI crop recommendations
      match /crop_recommendations/{recId} {
        allow read, write: if request.auth != null && request.auth.uid == farmerId;
      }
    }

    // Public regional agricultural advisories (read-only for all farmers)
    match /advisories/{advisoryId} {
      allow read: if request.auth != null;
      allow write: if false; // only written by backend agricultural admins
    }
  }
}
