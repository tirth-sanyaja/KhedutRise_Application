{
  "files.encoding": "utf8",
  "java.import.gradle.enabled": false,
  "java.import.exclusions": [
    "**/android/**",
    "**/build/**",
    "**/.dart_tool/**",
    "**/.gradle/**",
    "**/.kotlin/**"
  ],
  "gradle.nestedProjects": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.dart_tool": true,
    "**/.dart_tool/**": true,
    "**/chrome-device": true,
    "**/chrome-device/**": true,
    "**/.gradle": true,
    "**/.gradle/**": true,
    "**/.kotlin": true,
    "**/.kotlin/**": true,
    "**/.idea": true,
    "**/.idea/**": true,
    "**/*.iml": true,
    "**/build": true,
    "**/build/**": true
  }
}
